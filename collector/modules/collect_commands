#!/usr/bin/env bash
#################################################################################################
# Execute commands to collect data
#################################################################################################

function collect_cmds() {
  echo "Collecting command outputs"

  IFS="" #Change the delimiter to prevent Bash separating elements by spaces
  commands_to_collect=(
    "df"
    "df -h"
    "dmesg -T"
    "dmidecode"
    "free -m"
    "lscpu"
    "lscpu -p=CPU,NODE,SOCKET"
    "lspci"
    "lspci -vv"
    "lspci -nn"
    "lspci -tvvv"
    "lsmem"
    "lsmem -o RANGE,SIZE,STATE,REMOVABLE,ZONES,NODE,BLOCK"
    "lsmem -a -o RANGE,SIZE,STATE,REMOVABLE,ZONES,NODE,BLOCK"
    "lsmod"
    "lsblk -o NAME,MODEL,SERIAL,SIZE,ROTA,TYPE,TRAN,STATE,VENDOR"
    "lsblk -d -o NAME,ROTA,TYPE,TRAN"
    "numactl -H"
    "numactl --help"
    "numactl --version"
    "mount -v"
    "uname -a"
    "ls -l /sys/bus/cxl/devices/"
    "ls -l /sys/bus/platform/devices/"
    "grep -r . /sys/kernel/mm/numa/"
    "grep -r . /sys/devices/virtual/memory_tiering/"
    "grep -r . /sys/kernel/mm/mempolicy/weighted_interleave/"
    "grep -rs . /sys/devices/system/node/ --include=demotion_targets"
    "grep -rs . /sys/devices/system/edac/mc/ --include=ce_count --include=ue_count --include=dimm_label --include=dimm_ce_count --include=dimm_ue_count"
    "grep -rs . /sys/devices/system/cpu/cpufreq/ --include=scaling_governor --include=scaling_driver --include=boost"
    "grep -rs . /sys/devices/system/cpu/intel_pstate/"
    "grep -rs . /sys/devices/system/cpu/cpu0/cpuidle/ --include=name --include=latency --include=disable"
    "grep -rs . /sys/class/powercap/ --include=constraint_0_power_limit_uw --include=constraint_0_max_power_uw --include=name"
    "cat /sys/devices/system/cpu/offline"
    "cat /sys/devices/system/cpu/smt/control"
    "find /sys/kernel/iommu_groups/ -maxdepth 2 -type l"
    "rdmsr -a 0x1a4"
    "nvidia-smi topo -m"
    "nvidia-smi -q"
    "/usr/local/cuda/gds/tools/gdscheck -p"
    "nvidia-smi --query-gpu=index,pci.bus_id,pcie.link.gen.max,pcie.link.gen.current,pcie.link.width.max,pcie.link.width.current --format=csv,noheader"
    "amd-smi list --csv"
    "rocm-smi --showbus --csv"
  )

  # Initialize the progress bar
  # One extra step for the kernel config collection below
  init_progressbar "$((${#commands_to_collect[@]} + 1))"

  for cmd in "${commands_to_collect[@]}"; do
    # Provide progress to user
    inc_progressbar

    if [ ${OPT_VERBOSITY} -ge 2 ]; then
      debug_msg "Collecting ${cmd}"
    fi
    # Create output files
    # Replace spaces in the command and agrs to be used as the output file name
    OFNAME="${cmd}"
    OFNAME="${OFNAME// /_}" # Use the Bash string replace feature rather than calling sed or awk
    OFNAME="${OFNAME//\//_}" # Replace '/' too, since some commands take path arguments
    CMD_OUTPUT_FILE="${OUTPUT_PATH}/${OFNAME}"
    CMD_ERR_OUTPUT_FILE="${OUTPUT_PATH}/${OFNAME}.err"
    # Run the command with arguments
    # Redirect errors to the error file
    if eval "${cmd}" 2> ${CMD_ERR_OUTPUT_FILE} 1> ${CMD_OUTPUT_FILE} ; then
      if [ ${OPT_VERBOSITY} -ge 1 ]; then
        debug_msg "${cmd} Command ${green}succeeded${normal}"
      fi
    else
      if [ ${OPT_VERBOSITY} -ge 1 ]; then
        debug_msg "${cmd} Command ${red}failed${normal}"
      fi
    fi
  done

  # Collect the running kernel's config. There is no single fixed command for it, so it
  # is not part of the commands_to_collect array above: try /boot/config-$(uname -r)
  # first, then fall back to /proc/config.gz (requires CONFIG_IKCONFIG_PROC).
  # Stable output file name: 'kernel_config' (read by analyzer/cxl/register_locator_dvsec)
  inc_progressbar
  local kernel_config_file
  kernel_config_file="/boot/config-$(uname -r)"
  if [[ -f ${kernel_config_file} ]]; then
    if ${CP} "${kernel_config_file}" "${OUTPUT_PATH}/kernel_config" 2> "${OUTPUT_PATH}/cp_kernel_config.err"; then
      if [ ${OPT_VERBOSITY} -ge 1 ]; then
        debug_msg "kernel config ${green}succeeded${normal}"
      fi
    else
      if [ ${OPT_VERBOSITY} -ge 1 ]; then
        debug_msg "kernel config ${red}failed${normal}"
      fi
    fi
  elif [[ -n "${ZCAT}" && -f /proc/config.gz ]]; then
    if "${ZCAT}" /proc/config.gz > "${OUTPUT_PATH}/kernel_config" 2> "${OUTPUT_PATH}/cp_kernel_config.err"; then
      if [ ${OPT_VERBOSITY} -ge 1 ]; then
        debug_msg "kernel config (from /proc/config.gz) ${green}succeeded${normal}"
      fi
    else
      if [ ${OPT_VERBOSITY} -ge 1 ]; then
        debug_msg "kernel config (from /proc/config.gz) ${red}failed${normal}"
      fi
    fi
  elif [ ${OPT_VERBOSITY} -ge 1 ]; then
    debug_msg "kernel config ${yellow}not found${normal}"
  fi
  echo ""
}

#################################################################################################
# Main
#################################################################################################

collect_cmds
