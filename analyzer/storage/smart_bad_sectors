#!/usr/bin/env bash
# set -x
# Prevent repeated sourcing
if [ -n "${_MODULE_CHECK_STORAGE_SMART_BAD_SECTORS_}" ]; then
  return
fi
_MODULE_CHECK_STORAGE_SMART_BAD_SECTORS_="Loaded"

# Check the ATA SMART attribute table (collected via 'smartctl -a') for the three classic
# bad-sector counters on SATA/SAS drives: Reallocated_Sector_Ct (already remapped), Current_
# Pending_Sector (awaiting remap, not yet confirmed bad) and Offline_Uncorrectable (found during
# an offline/background scan). Any non-zero RAW_VALUE here is real media degradation, unrelated
# to smartctl's own normalized VALUE/THRESH pass-fail scoring which can stay "healthy" for a long
# time after sectors start going bad.
function storage_smart_bad_sectors() {
  local FNAME_GLOB="${OUTPUT_PATH}/smartctl_-a_*"
  local fname devname line attr raw
  local ndev=0 bad=0 matched=0

  for fname in ${FNAME_GLOB}; do
    [[ -f ${fname} && ${fname} != *.err ]] || continue

    # Only ATA drives report this attribute table; NVMe/SAS devices simply won't match.
    ${GREP} -qE "^[[:space:]]*(5|196|197|198)[[:space:]]+(Reallocated_Sector_Ct|Reallocated_Event_Count|Current_Pending_Sector|Offline_Uncorrectable)" "${fname}" || continue

    matched=1
    ndev=$((ndev + 1))
    devname="$(basename "${fname}")"
    devname="${devname#smartctl_-a_}"

    local dev_bad=0
    while read -r line; do
      [[ -z ${line} ]] && continue
      attr=$(${AWK} '{print $2}' <<< "${line}")
      raw=$(${AWK} '{print $NF}' <<< "${line}")
      # Force base-10 interpretation - a zero-padded RAW_VALUE would otherwise be treated as
      # (possibly invalid) octal by bash arithmetic.
      if [[ ${raw} =~ ^[0-9]+$ ]] && (( 10#${raw} > 0 )); then
        dev_bad=1
        warn_msg "${devname}: ${attr} raw value is ${raw} (non-zero)." 2
      fi
    done <<< "$(${GREP} -E "^[[:space:]]*(5|196|197|198)[[:space:]]+(Reallocated_Sector_Ct|Reallocated_Event_Count|Current_Pending_Sector|Offline_Uncorrectable)" "${fname}")"

    [[ ${dev_bad} -eq 1 ]] && bad=$((bad + 1))
  done

  if [[ ${matched} -eq 0 ]]; then
    rule_result SKIPPED "No 'smartctl_-a_*' files with an ATA bad-sector attribute table found in '${OUTPUT_PATH}'. smartmontools not installed, or only NVMe/SAS devices present."
    return
  fi

  if [[ ${bad} -gt 0 ]]; then
    rule_result WARNING "${bad} of ${ndev} ATA device(s) report non-zero reallocated/pending/uncorrectable sector counts. See details above - media is degrading."
  else
    rule_result PASSED "All ${ndev} ATA device(s) report zero reallocated/pending/uncorrectable sectors."
  fi
}

storage_smart_bad_sectors

set +x
